{
  "name": "geopulse-studio",
  "version": "5.1.0",
  "private": true,
  "description": "GeoPulse Studio - Commercial Generative Engine Optimization (GEO) Publishing System",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && npm run build:owner",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:owner": "esbuild scripts/bootstrap-owner.ts --bundle --platform=node --format=cjs --external:next/headers --outfile=.next/owner-bootstrap.cjs",
    "owner:bootstrap": "node .next/owner-bootstrap.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "overrides": {
    "postcss": "8.5.34"
  }
}
