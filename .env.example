# ============ 基础站点与域名配置 ============
# 绑定到 Caddy 自动 HTTPS 的生产域名（本地运行可留 localhost）
DOMAIN=geo.yourdomain.com
# 应用公网访问 URL（用于生成 JSON-LD、/llms.txt、/sitemap.xml 的规范链接）
APP_URL=https://geo.yourdomain.com
NEXT_PUBLIC_APP_URL=https://geo.yourdomain.com

# ============ 安全与管理员配置 ============
# 会话签名与 BYOK 密钥 AES-256-GCM 加密主密钥（生产环境务必设为 64 位随机十六进制串）
SESSION_SECRET=replace-with-64-char-random-hex-secret-in-production
# 占位值、历史开发默认值与重复字符在生产环境无效；请生成私有随机密钥。
# 已有站点必须保留原密钥，否则存量加密凭据无法解密。
# 填写私有站长邮箱后，通过本地 bootstrap-owner CLI 显式创建管理员。
# 公开注册不会授予管理权限，演示邮箱不能充当所有者。
ADMIN_EMAIL=
# 开启严格商用计费：true 时普通用户无法自助免费切换 Pro/Enterprise，必须通过激活码升级
COMMERCIAL_STRICT_BILLING=true

# ============ 可选：服务端全局 LLM 算力池 ============
# 配置后，付费客户无需自行填写 API Key 即可使用实时大模型生成与收录探测
# 支持: none | deepseek | openai | gemini | custom
GLOBAL_LLM_PROVIDER=none
GLOBAL_LLM_BASE_URL=
GLOBAL_LLM_API_KEY=
GLOBAL_LLM_MODEL=

# ============ 数据持久化 ============
GEOPULSE_DATA_DIR=./data

# ============ 可选：支付回调 ============
# 未配置共享密钥时，回调返回 503；不要把真实密钥提交到版本库。
PAYMENT_WEBHOOK_SECRET=
# LemonSqueezy variant ID 到规范 SKU 的 JSON 对照表；只处理 live paid order_created。
# 示例值仅演示格式，请替换成自己的真实 variant ID：{"123":"credits_100"}
PAYMENT_LEMONSQUEEZY_VARIANT_SKUS={}
